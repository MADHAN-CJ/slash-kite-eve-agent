{
  "layout": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<meta name=\"supported-color-schemes\" content=\"dark\">\n<title>{{subject}}</title>\n<!-- layout.html: the frame every /markets email shares. Each message's email.html goes in as the body.\n     Email-safe on purpose: tables, inline styles, one style block for phones, no scripts, no SVG, no web fonts. -->\n<style>\nbody{margin:0;padding:0;background:#0F1114}\na{color:#8CB8FF}\n@media (max-width:620px){\n  .px{padding-left:20px!important;padding-right:20px!important}\n  .big{font-size:34px!important}\n  .stack,.stack td{display:block!important;width:100%!important}\n  .stack td{padding:0 0 10px!important}\n  .stack a{display:block!important;text-align:center!important}\n}\n</style>\n</head>\n<body style=\"margin:0;padding:0;background:#0F1114;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;\">{{preheader}}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#0F1114;\">\n<tr><td align=\"center\" style=\"padding:28px 10px 40px;\">\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;\">\n    <tr><td class=\"px\" style=\"padding:0 32px 16px;font-family:'Timeless Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;font-weight:600;letter-spacing:-0.01em;color:#F5F7FA;\"><span style=\"color:#3D6BFF;\">/</span>markets</td></tr>\n    <tr><td style=\"background:#16191E;border:1px solid #262A31;border-radius:12px;\">\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr><td class=\"px\" style=\"padding:32px 32px 30px;font-family:'Timeless Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#A9B1BD;\">\n{{{body}}}\n        </td></tr>\n      </table>\n    </td></tr>\n    <tr><td class=\"px\" style=\"padding:20px 32px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#7D8591;\">\n      {{footer}}\n      {{#link.settings}}<br><br>{{#link.watchers}}<a href=\"{{link.watchers}}\" style=\"color:#A9B1BD;text-decoration:none;\">Watchers</a> &nbsp;\u00b7&nbsp; {{/link.watchers}}<a href=\"{{link.settings}}\" style=\"color:#A9B1BD;text-decoration:none;\">Email settings</a>{{/link.settings}}\n    </td></tr>\n  </table>\n</td></tr>\n</table>\n</body>\n</html>\n",
  "messages": {
    "otp": {
      "subject": "{{code}} is your /markets code",
      "preheader": "It works for 10 minutes. If you didn\u2019t ask for it, ignore this email.",
      "footer": "Sent to {{email}} because someone entered it on /markets. We never ask for this code by phone or chat.",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8CB8FF;\">{{eyebrow}}</p>\n<h1 style=\"margin:0 0 18px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{lead}}</h1>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;\">\n  <tr><td style=\"padding:14px 20px;border:1px solid #262A31;border-radius:8px;background:#0F1114;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:36px;line-height:1;letter-spacing:0.18em;color:#F5F7FA;\" class=\"big\">{{code}}</td></tr>\n</table>\n<p style=\"margin:0 0 14px;\">It works for 10 minutes, and only once. {{#returning}}It signs you in to the account you already have.{{/returning}}{{^returning}}Once you\u2019re in, a short tour shows you around.{{/returning}}</p>\n<p style=\"margin:0;font-size:13px;color:#7D8591;\">Asked for at {{at}} \u00b7 {{device}}. If that wasn\u2019t you, ignore this email. Nobody can get in without the code.</p>\n",
      "text": "{{code}} is your /markets code\n\n{{lead}}\n\nIt works for 10 minutes, and only once.\n\nAsked for at {{at}} \u00b7 {{device}}. If that wasn\u2019t you, ignore this email. Nobody can get in without the code.\n\n--\n{{footer}}\n"
    },
    "kite-nudge": {
      "subject": "{{subject}}",
      "preheader": "{{preheader}}",
      "footer": "Sent to {{email}} because you signed up and haven\u2019t connected Kite. {{cap}}",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8CB8FF;\">{{eyebrow}}</p>\n<h1 style=\"margin:0 0 12px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{head}}</h1>\n<p style=\"margin:0 0 18px;\">{{lead}}</p>\n{{#question}}\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px;\">\n  <tr><td style=\"padding:14px 16px;border:1px solid #262A31;border-left:2px solid #8CB8FF;border-radius:6px;background:#0F1114;\">\n    <p style=\"margin:0 0 4px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#7D8591;\">Waiting \u00b7 asked {{asked}}</p>\n    <p style=\"margin:0;font-size:16px;color:#F5F7FA;\">{{question}}</p>\n  </td></tr>\n</table>\n{{/question}}\n{{#can.length}}\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px;\">\n  {{#can}}<tr><td style=\"padding:9px 0;border-top:1px solid #262A31;font-size:14px;\"><span style=\"color:#F5F7FA;\">{{q}}</span><br><span style=\"color:#7D8591;\">{{a}}</span></td></tr>{{/can}}\n</table>\n{{/can.length}}\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;\">\n  <tr><td style=\"border-radius:6px;background:#F5F7FA;\"><a href=\"{{link.connect}}\" style=\"display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0B0D10;text-decoration:none;border-radius:6px;\">Connect Kite</a></td></tr>\n</table>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 6px;\">\n  <tr>\n    <td style=\"padding:0 16px 0 0;font-size:13px;color:#7D8591;width:33%;\" valign=\"top\"><span style=\"color:#F5F7FA;\">Read-only</span><br>It can\u2019t place orders.</td>\n    <td style=\"padding:0 16px 0 0;font-size:13px;color:#7D8591;width:33%;\" valign=\"top\"><span style=\"color:#F5F7FA;\">Until 6:00 AM</span><br>Kite ends it daily.</td>\n    <td style=\"font-size:13px;color:#7D8591;\" valign=\"top\"><span style=\"color:#F5F7FA;\">Free</span><br>No card needed.</td>\n  </tr>\n</table>\n<p style=\"margin:16px 0 0;font-size:13px;color:#7D8591;\">One login on Kite\u2019s own page. We never see your password. <a href=\"{{link.safe}}\" style=\"color:#8CB8FF;text-decoration:none;\">Is it safe?</a></p>\n",
      "text": "{{head}}\n\n{{lead}}\n{{#question}}\nWaiting, asked {{asked}}: \u201c{{question}}\u201d\n{{/question}}\n{{#can}}\n- {{q}}: {{a}}\n{{/can}}\n\nConnect Kite: {{link.connect}}\n\nRead-only, it can\u2019t place orders. Lasts until 6:00 AM. Free.\nOne login on Kite\u2019s own page. We never see your password.\nIs it safe? {{link.safe}}\n\n--\n{{footer}}\nEmail settings: {{link.settings}}\n"
    },
    "kite-reconnect": {
      "subject": "{{subject}}",
      "preheader": "Kite ended your session at 6:00 AM. Reconnect before 9:15 and nothing is missed.",
      "footer": "Sent to {{email}} only on mornings when Kite has paused your watchers, and two mornings in a row at most.",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8CB8FF;\">{{eyebrow}}</p>\n<h1 style=\"margin:0 0 12px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{head}}</h1>\n<p style=\"margin:0 0 18px;\">{{lead}}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 22px;font-size:14px;\">\n  {{#paused}}<tr>\n    <td style=\"padding:9px 10px 9px 0;border-top:1px solid #262A31;width:12px;\" valign=\"top\"><span style=\"display:inline-block;width:8px;height:8px;border-radius:4px;background:#F2C38B;\"></span></td>\n    <td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#F5F7FA;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;white-space:nowrap;\" valign=\"top\">{{sym}}</td>\n    <td style=\"padding:8px 0;border-top:1px solid #262A31;color:#A9B1BD;\" valign=\"top\">{{rule}}</td>\n  </tr>{{/paused}}\n</table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;\">\n  <tr><td style=\"border-radius:6px;background:#F5F7FA;\"><a href=\"{{link.kite}}\" style=\"display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0B0D10;text-decoration:none;border-radius:6px;\">Reconnect Kite</a></td></tr>\n</table>\n<p style=\"margin:0;font-size:13px;color:#7D8591;\">One login on Kite\u2019s own page. We never see your password. {{after}}</p>\n",
      "text": "{{head}}\n\n{{lead}}\n\nPaused:\n{{#paused}}\n- {{sym}}: {{rule}}\n{{/paused}}\n\nReconnect Kite: {{link.kite}}\n\nOne login on Kite\u2019s own page. We never see your password. {{after}}\n\n--\n{{footer}}\nWatchers: {{link.watchers}}\nEmail settings: {{link.settings}}\n"
    },
    "watcher-alert": {
      "subject": "{{sym}} {{said}} \u00b7 {{value}}",
      "preheader": "{{rule}}. Checked at {{at}}, {{ex}}.",
      "footer": "Facts from market data. Not investment advice. /markets reads data only and never places orders. Sent to {{email}}.",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#7EE2A8;\">Your watcher is true</p>\n<h1 style=\"margin:0 0 16px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{sym}} {{said}}</h1>\n<p style=\"margin:0 0 18px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;color:#7D8591;\"><span class=\"big\" style=\"font-size:40px;line-height:1;letter-spacing:-0.02em;color:#F5F7FA;\">{{value}}</span>&nbsp; at {{at}} \u00b7 {{ex}}</p>\n<img src=\"{{chart}}\" width=\"534\" alt=\"{{chartAlt}}\" style=\"display:block;width:100%;max-width:534px;height:auto;margin:0 0 20px;border:0;border-radius:6px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 22px;font-size:14px;\">\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#7D8591;width:120px;\" valign=\"top\">Your rule</td><td style=\"padding:8px 0;border-top:1px solid #262A31;color:#F5F7FA;\">{{rule}}</td></tr>\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#7D8591;\" valign=\"top\">Checks</td><td style=\"padding:8px 0;border-top:1px solid #262A31;color:#F5F7FA;\">{{checks}}</td></tr>\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#7D8591;\" valign=\"top\">Ends</td><td style=\"padding:8px 0;border-top:1px solid #262A31;color:#F5F7FA;\">{{ends}}</td></tr>\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;color:#7D8591;\" valign=\"top\">From the chat</td><td style=\"padding:8px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;color:#F5F7FA;\">{{chat}}</td></tr>\n</table>\n<table role=\"presentation\" class=\"stack\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 20px;\">\n  <tr>\n    <td style=\"padding:0 10px 0 0;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td style=\"border-radius:6px;background:#F5F7FA;\"><a href=\"{{link.chat}}\" style=\"display:inline-block;padding:12px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0B0D10;text-decoration:none;border-radius:6px;\">Open in chat</a></td></tr></table></td>\n    <td><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\"><tr><td style=\"border-radius:6px;border:1px solid #3A3F48;\"><a href=\"{{link.trade}}\" style=\"display:inline-block;padding:11px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#F5F7FA;text-decoration:none;border-radius:6px;\">Trade on Kite</a></td></tr></table></td>\n  </tr>\n</table>\n<p style=\"margin:0;font-size:13px;color:#7D8591;\">It emails again only after {{sym}} {{again}} and crosses again. Pause or cancel it on the Watchers page.</p>\n",
      "text": "Your watcher is true\n\n{{sym}} {{said}}\n{{value}} at {{at}} \u00b7 {{ex}}\n\nYour rule:     {{rule}}\nChecks:        {{checks}}\nEnds:          {{ends}}\nFrom the chat: {{chat}}\n\nOpen in chat:  {{link.chat}}\nTrade on Kite: {{link.trade}}\n\nIt emails again only after {{sym}} {{again}} and crosses again. Pause or cancel it on the Watchers page.\n\n--\n{{footer}}\nWatchers: {{link.watchers}}\nEmail settings: {{link.settings}}\n"
    },
    "watcher-stopped": {
      "subject": "Your {{sym}} watcher stopped: {{short}}",
      "preheader": "It won\u2019t check again until it\u2019s fixed. Fix it in chat hands the error to the agent.",
      "footer": "Sent to {{email}} once when a watcher stops. Not again for the same error.",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#FF7A77;\">Watcher stopped</p>\n<h1 style=\"margin:0 0 12px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{sym}}: {{rule}}</h1>\n<p style=\"margin:0 0 18px;\">{{why}} It won\u2019t check again until it\u2019s fixed.</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;font-size:14px;\">\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#7D8591;width:130px;\" valign=\"top\">Stopped</td><td style=\"padding:8px 0;border-top:1px solid #262A31;color:#F5F7FA;\">{{stopped}}</td></tr>\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;color:#7D8591;\" valign=\"top\">Last good check</td><td style=\"padding:8px 0;border-top:1px solid #262A31;color:#F5F7FA;\">{{lastGood}}</td></tr>\n  <tr><td style=\"padding:8px 12px 8px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;color:#7D8591;\" valign=\"top\">The error</td><td style=\"padding:8px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;color:#F5F7FA;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12.5px;\">{{error}}</td></tr>\n</table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;\">\n  <tr><td style=\"border-radius:6px;background:#F5F7FA;\"><a href=\"{{link.fix}}\" style=\"display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0B0D10;text-decoration:none;border-radius:6px;\">Fix it in chat</a></td></tr>\n</table>\n<p style=\"margin:0;font-size:13px;color:#7D8591;\">Fix it in chat opens the chat it came from, with the script and this error, so the agent can fix it. {{hint}}</p>\n",
      "text": "Watcher stopped\n\n{{sym}}: {{rule}}\n{{why}} It won\u2019t check again until it\u2019s fixed.\n\nStopped:         {{stopped}}\nLast good check: {{lastGood}}\nThe error:       {{error}}\n\nFix it in chat: {{link.fix}}\nFix it in chat opens the chat it came from, with the script and this error, so the agent can fix it. {{hint}}\n\n--\n{{footer}}\nWatchers: {{link.watchers}}\nEmail settings: {{link.settings}}\n"
    },
    "watcher-ended": {
      "subject": "{{subject}}",
      "preheader": "{{preheader}}",
      "footer": "Sent to {{email}} when a watcher reaches its end date. Cancelled watchers don\u2019t get one.",
      "html": "<p style=\"margin:0 0 10px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;color:#8CB8FF;\">Watcher ended</p>\n<h1 style=\"margin:0 0 12px;font-family:'Source Serif 4',Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;font-weight:500;letter-spacing:-0.02em;color:#F5F7FA;\">{{sym}}: {{rule}}</h1>\n<p style=\"margin:0 0 18px;\">{{lead}}</p>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 22px;\">\n  <tr>\n    <td style=\"padding:12px 12px 12px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;width:33%;\" valign=\"top\"><span style=\"font-size:12px;color:#7D8591;\">Ran</span><br><span style=\"font-size:15px;color:#F5F7FA;\">{{ran}}</span></td>\n    <td style=\"padding:12px 12px 12px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;width:33%;\" valign=\"top\"><span style=\"font-size:12px;color:#7D8591;\">Emails sent</span><br><span style=\"font-size:15px;color:#F5F7FA;\">{{sent}}</span></td>\n    <td style=\"padding:12px 0;border-top:1px solid #262A31;border-bottom:1px solid #262A31;\" valign=\"top\"><span style=\"font-size:12px;color:#7D8591;\">{{lastLabel}}</span><br><span style=\"font-size:15px;color:#F5F7FA;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;\">{{last}}</span></td>\n  </tr>\n</table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin:0 0 18px;\">\n  <tr><td style=\"border-radius:6px;background:#F5F7FA;\"><a href=\"{{link.again}}\" style=\"display:inline-block;padding:12px 22px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#0B0D10;text-decoration:none;border-radius:6px;\">Watch again</a></td></tr>\n</table>\n<p style=\"margin:0;font-size:13px;color:#7D8591;\">Watch again starts the same rule for another 30 days. {{note}}</p>\n",
      "text": "Watcher ended\n\n{{sym}}: {{rule}}\n{{lead}}\n\nRan:          {{ran}}\nEmails sent:  {{sent}}\n{{lastLabel}}: {{last}}\n\nWatch again: {{link.again}}\nWatch again starts the same rule for another 30 days. {{note}}\n\n--\n{{footer}}\nWatchers: {{link.watchers}}\nEmail settings: {{link.settings}}\n"
    }
  }
}
