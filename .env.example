# --- Database: ONE Postgres shared with the /markets Kite MCP (plan D15) ---
# The MCP owns schema `public` (users, otps, broker_connections, watchers, oauth_*);
# this app owns schema `eve`. Run the MCP's migrations first (`npm run db:mcp-init`
# locally), then `npm run db:migrate`. Local docker: `docker compose up -d`.
DATABASE_URL=postgres://slashkite:slashkite@localhost:5439/slash_kite_eve
# Set when the provider has a connection pooler (migrations use the direct URL).
# DATABASE_URL_UNPOOLED=

# --- Model (the eve runtime calls Anthropic directly) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5 (default) or claude-opus-5-5
# AGENT_MODEL=claude-sonnet-5

# --- Web search (Tavily) ---
TAVILY_API_KEY=

# --- The Kite MCP this agent connects to (plan D16: trusted-app grant) ---
# Production: https://mcp.slash.markets · staging: https://staging-kite-mcp.slash.markets
KITE_MCP_URL=https://mcp.slash.markets
# Public base URL of THIS app — Zerodha returns to <APP_BASE_URL>/api/broker/kite/callback,
# which must be the redirect URL registered on the Kite Connect app.
APP_BASE_URL=http://localhost:3000
# The confidential client the MCP knows this deployment as, and the secret that
# signs the per-user JWT-bearer assertions. MUST equal the MCP's
# ZAP_KITE_MCP_TRUSTED_CLIENT_ID / _SECRET / ZAP_KITE_MCP_ASSERTION_SECRET.
MCP_TRUSTED_CLIENT_ID=slash-kite-eve
MCP_TRUSTED_CLIENT_SECRET=
MCP_ASSERTION_SECRET=
# Secrets shared with the MCP so it can read what this app writes into its tables
# (Kite tokens, login-code hashes). MUST equal the MCP's SESSION_SECRET and
# CREDS_ENCRYPTION_KEY for the same database.
MCP_SESSION_SECRET=
MCP_CREDS_ENCRYPTION_KEY=

# --- Zerodha Kite Connect app (Login with Kite; same app the MCP uses) ---
KITE_API_KEY=
KITE_API_SECRET=
# KITE_BASE_URL=https://api.kite.trade
# KITE_LOGIN_URL=https://kite.zerodha.com/connect/login

# --- Secrets (each: openssl rand -hex 32; never reuse across products) ---
# Signs the 7-day /markets session JWTs.
AUTH_JWT_SECRET=
# Encrypts this app's cached MCP access tokens at rest (rotating it only drops
# the cache — tokens are re-minted on demand).
CREDS_ENCRYPTION_KEY=
# Shared secret between the Next proxy and the eve runtime channel.
EVE_PROXY_SECRET=

# --- Email (login codes). Unset → codes are logged to the server console. ---
# RESEND_API_KEY=
# Must be on a Resend-VERIFIED domain.
# OTP_FROM_EMAIL=Slash Markets <login-link@codeongrass.com>
# OTP_COOLDOWN_SECONDS=30

# Development only: a fixed login that needs no email. Never set these in production.
# DEV_LOGIN_EMAIL=test@slash.markets
# DEV_LOGIN_CODE=123456

# --- Topology ---
# Leave unset: withEve serves the eve runtime on this same origin, locally AND on
# Vercel (one project, `slash-kite-eve`). Set only for a split runtime project.
# EVE_UPSTREAM_ORIGIN=
