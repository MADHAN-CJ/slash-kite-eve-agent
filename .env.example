# --- Database (local docker: `docker compose up -d`) ---
DATABASE_URL=postgres://slashkite:slashkite@localhost:5439/slash_kite_eve
# Neon prod: also set DATABASE_URL_UNPOOLED (direct connection) for migrations.
# DATABASE_URL_UNPOOLED=

# --- Model (the eve runtime calls Anthropic directly) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5 (default) or claude-opus-5-5
# AGENT_MODEL=claude-sonnet-5

# --- Web search (Tavily) ---
TAVILY_API_KEY=

# --- The Kite MCP this agent connects to (OAuth 2.1; see docs/plan-v1.md D3/D4) ---
# Production: https://mcp.slash.markets · staging: https://staging-kite-mcp.slash.markets
KITE_MCP_URL=https://mcp.slash.markets
# Public base URL of THIS app — the OAuth redirect URI is <APP_BASE_URL>/api/mcp/callback.
APP_BASE_URL=http://localhost:3000

# --- Secrets (each: openssl rand -hex 32; never reuse across products) ---
# Signs the 7-day /markets session JWTs.
AUTH_JWT_SECRET=
# Encrypts MCP grants (OAuth tokens) at rest. Rotating it drops every stored
# grant (users just log in again) — pin it per environment.
CREDS_ENCRYPTION_KEY=
# HMAC pepper for one-time login codes.
CREDS_HASH_PEPPER=
# Shared secret between the Next proxy and the eve runtime channel.
EVE_PROXY_SECRET=

# --- Email (login codes). Unset → codes are logged to the server console. ---
# RESEND_API_KEY=
# Must be on a Resend-VERIFIED domain.
# OTP_FROM_EMAIL=Slash Markets <login-link@codeongrass.com>
# OTP_COOLDOWN_SECONDS=30

# Development only: a fixed login that needs no email. Never set these in production.
# DEV_LOGIN_EMAIL=test@slash.markets
# DEV_LOGIN_CODE=123456

# --- Topology ---
# Leave unset: withEve serves the eve runtime on this same origin, locally AND on
# Vercel (one project, `slash-kite-eve`). Set only for a split runtime project.
# EVE_UPSTREAM_ORIGIN=
